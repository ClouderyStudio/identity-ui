{
  "name": "@cloudery/identity-ui",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "云术身份中心 UI：Material Design 3 的登录 / 注册 / 找回 / 改密 / 账户面板 / 管理后台",
  "files": [
    "dist-lib"
  ],
  "main": "./dist-lib/identity-ui.js",
  "module": "./dist-lib/identity-ui.js",
  "exports": {
    ".": "./dist-lib/identity-ui.js",
    "./style.css": "./dist-lib/identity-ui.css"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vue-tsc -b && vite build --mode lib",
    "build:mock": "vue-tsc -b && vite build --mode mock",
    "preview:mock": "vite preview --outDir dist-mock --port 4173",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "shots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@clderystd/m3-ui": "0.4.0",
    "vue": "^3.5.42",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "@iconify-json/material-symbols": "^1.2.97",
    "@iconify-json/simple-icons": "^1.2.101",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}