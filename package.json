{
  "name": "@cloudery/identity-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "云术身份中心 UI：明暗双主题的登录 / 注册 / 找回 / 改密 / 账户面板",
  "files": [
    "dist"
  ],
  "main": "./dist/identity-ui.js",
  "module": "./dist/identity-ui.js",
  "exports": {
    ".": "./dist/identity-ui.js",
    "./style.css": "./dist/identity-ui.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vue-tsc -b && vite build --mode lib",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
